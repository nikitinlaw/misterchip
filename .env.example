DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=misterchip
DB_USER=misterchip
DB_PASSWORD=local-development-only
DB_HOST=localhost
DB_PORT=5432

# Shared Redis required for authentication throttling.
REDIS_URL=redis://localhost:6379/1
# Development only: prints verification/reset links to the web container logs.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MISTERCHIP <noreply@example.invalid>
