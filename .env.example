DJANGO_SECRET_KEY=replace-this-with-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Enable only behind Caddy with a private/loopback upstream and no direct public app port.
DJANGO_TRUST_PROXY_CLIENT_IP=0
# Email links use a fixed, trusted origin. Override for a local-only test if needed.
PUBLIC_SITE_URL=https://misterchip.ru
DB_NAME=misterchip
DB_USER=misterchip
DB_PASSWORD=local-development-only
DB_HOST=localhost
DB_PORT=5432

# Shared Redis required for authentication throttling.
REDIS_URL=redis://localhost:6379/1
# Development only: prints verification/reset links to the web container logs.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=MISTERCHIP <noreply@example.invalid>
# Production: set Django SMTP backend, valid FROM, SMTP host and secret.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.test
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# For implicit TLS (usually port 465): EMAIL_USE_TLS=0 and EMAIL_USE_SSL=1.
# Keep SMTP credentials outside Git and run runtime_status --require-smtp
# before an explicitly authorized real delivery test.
