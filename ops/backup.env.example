# Copy to /etc/misterchip/backup.env, root:root mode 0600.
# Literal KEY=VALUE syntax; paired quotes are allowed. No shell expansion.
# Select an independent storage service and create a private bucket first.
PROJECT_DIR=/home/misterchip-admin/misterchip
STATE_DIR=/var/lib/misterchip-ops
RESTIC_REPOSITORY=s3:https://object-storage.example.invalid/private-bucket/misterchip
RESTIC_PASSWORD_FILE=/etc/misterchip/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_SESSION_TOKEN=
